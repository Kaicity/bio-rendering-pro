# Port lắng nghe của Express Server
PORT=3000

# MongoDB Connection String (Local MongoDB hoặc MongoDB Atlas)
# Ví dụ local: mongodb://127.0.0.1:27017/bio-rendering
# Ví dụ Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bio-rendering?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bio-rendering

# UploadThing API Token (Lấy từ https://uploadthing.com/dashboard -> API Keys)
# Token có định dạng: ufs_...
UPLOADTHING_TOKEN=

# URL của ứng dụng (dùng cho CORS hoặc routing)
APP_URL=http://localhost:3000
